# Copy this file to `.env` and fill in your values.
# .env is git-ignored and must never be committed.

# ── Deployment checklist ────────────────────────────────────────────────────
# Production: set a real SECRET_KEY, DEBUG=False, SESSION_COOKIE_SECURE=True
# (HTTPS only), and real API keys. Never commit .env; commit only this example.

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5001
DEBUG=True

# ── Session cookies ──────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED before exposing the server publicly.
SECRET_KEY=replace-me-with-a-random-secret

# Cookie hardening. Secure=True requires HTTPS and disables cookies on http://.
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_HTTPONLY=True

# ── CSRF ─────────────────────────────────────────────────────────────────────
# State-changing requests with an active session must echo the session token
# via the X-CSRF-Token header (the dashboard does this automatically).
CSRF_PROTECTION=True

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local dev (running `python main.py` on your host) — use localhost:
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=health_tracker

# Docker Compose mode: docker-compose.yml already injects this into the app
# container, so it does NOT need to be set here when using compose:
# MONGO_URI=mongodb://health-tracker-mongo:27017/health_tracker

MONGO_CONNECT_RETRIES=5
MONGO_CONNECT_RETRY_DELAY=2

# ── MongoDB TTL (days) — bounds growth of the meals and daily_logs collections ─
MONGO_MEALS_TTL_DAYS=365
MONGO_DAILY_LOGS_TTL_DAYS=365

# ── External API rate limiting (per client IP, sliding window) ───────────────
EXTERNAL_API_RATE_LIMIT=30
EXTERNAL_API_RATE_WINDOW_SECONDS=60

# Backend: "memory" (default, per-process) or "redis" (shared across workers;
# requires `pip install redis` and a reachable REDIS_URL).
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ── External API keys (optional; endpoints degrade to built-in data) ─────────
USDA_API_KEY=DEMO_KEY
EXERCISEDB_API_KEY=
# Leave GROQ_API_KEY empty to use the keyless rule-based chatbot instead of
# the Groq LLM. The rest of the app works with or without it.
GROQ_API_KEY=